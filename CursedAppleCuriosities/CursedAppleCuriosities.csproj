  <!-- ───── Post-build: copy DLL to the dev profile for quick in-game testing ───── -->
  <!-- Curiosities Dev is a clone of Hallowed Concepts Release (the post-DLC profile). The mod sits in Unknown-CursedAppleCuriosities
       there, so the build replaces it in place and there is never a second GUID. Hallowed Concepts Release stays frozen at 1.0.0. -->
  <!-- Debug only: a Release build registers just the released survivors and must not replace the dev DLL. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(Configuration)' != 'Release'">
    <MakeDir Directories="$(DevPluginDir)" />
    <Copy SourceFiles="$(TargetPath);$(NLayerDll)" DestinationFolder="$(DevPluginDir)" />
    <!-- Lash Playtest profile (clone of "Alloyed Goonlective super real"): same in-place replacement. -->
    <Copy Condition="Exists('$(PlaytestPluginDir)')" SourceFiles="$(TargetPath);$(NLayerDll)" DestinationFolder="$(PlaytestPluginDir)" />
  </Target>
  <PropertyGroup>
    <NLayerDll>$(NuGetPackageRoot)nlayer\1.16.0\lib\netstandard2.0\NLayer.dll</NLayerDll>
    <DevPluginDir>$(ProfilePath)\BepInEx\plugins\Unknown-CursedAppleCuriosities</DevPluginDir>
    <PlaytestPluginDir Condition="'$(PlaytestPluginDir)' == ''">C:\r2heimman\RiskOfRain2\profiles\Lash Playtest\BepInEx\plugins\Unknown-CursedAppleCuriosities</PlaytestPluginDir>
  </PropertyGroup>

  <!-- ───── Deadlock model converter (Source2Viewer-CLI, MIT) next to the DLL, copied once from VrfSource ───── -->
  <!-- It converts hero models from the player's OWN Deadlock install at runtime. No Valve file is ever shipped. -->
  <PropertyGroup>
    <VrfSource Condition="'$(VrfSource)' == ''">C:\r2heimman\Valheim\profiles\HeroBrew Playtest\BepInEx\plugins\gonkhub-HeroBrew\vrf</VrfSource>
  </PropertyGroup>
  <!-- Every profile the DLL goes to gets it too (without it a changed clip list can't convert there). -->
  <Target Name="DeployConverter" AfterTargets="DeployToProfile" Condition="Exists('$(VrfSource)\Source2Viewer-CLI.exe')">
    <ItemGroup><VrfFiles Include="$(VrfSource)\**\*" /></ItemGroup>
    <Copy Condition="!Exists('$(DevPluginDir)\vrf\Source2Viewer-CLI.exe')" SourceFiles="@(VrfFiles)" DestinationFolder="$(DevPluginDir)\vrf\%(RecursiveDir)" />
    <Copy Condition="Exists('$(PlaytestPluginDir)') And !Exists('$(PlaytestPluginDir)\vrf\Source2Viewer-CLI.exe')" SourceFiles="@(VrfFiles)" DestinationFolder="$(PlaytestPluginDir)\vrf\%(RecursiveDir)" />
  </Target>

  <!-- ───── Post-build (Release only): refresh the Thunderstore distributable zip ───── -->
  <!-- Calls package-only.ps1 (NOT build-package.ps1) so it never re-invokes the build. -->
  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\packaging\package-only.ps1&quot; -VrfSource &quot;$(VrfSource)&quot;" />
  </Target>

