<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converts a section of a Deadlock map from the player's own install into the cache the mod's stage loads.
       Runs as its own process (launched by the mod) so the game never carries the conversion's memory or CPU load.
       .NET Framework 4.7.2: present on every Windows 10/11 machine, no runtime to ship. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>CursedAppleMapConvert</AssemblyName>
    <RootNamespace>CursedAppleMapConvert</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Shared with the mod: the section definitions and the small JSON reader. -->
    <Compile Include="..\CursedAppleCuriosities\Stages\DeadlockMap\MapSectionDef.cs" Link="Shared\MapSectionDef.cs" />
    <Compile Include="..\CursedAppleCuriosities\Deadlock\MiniJson.cs" Link="Shared\MiniJson.cs" />
  </ItemGroup>

</Project>
